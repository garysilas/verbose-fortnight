{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "slate",
    "cssVariables": true
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils"
  },
  "registries": {
    "@shadcnio": {
      "url": "https://www.shadcn.io/r/{name}.json",
      "headers": {
        "Authorization": "Bearer ${SHADCNIO_TOKEN}"
      }
    }
  }
}
